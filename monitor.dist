# monitor.dist — Template di configurazione per platform-monitor-2-mqtt
#
# Istruzioni:
#   cp monitor.dist monitor.ini
#   Modificare monitor.ini secondo il proprio ambiente.
#   monitor.ini NON deve essere committato (è in .gitignore).
#
# Formato: INI standard, commenti con #, nessuna interpolazione di variabili.
# Le variabili d'ambiente MQTT_* hanno precedenza sulle opzioni di questa sezione.

# ---------------------------------------------------------------------------
[General]
# ---------------------------------------------------------------------------

# Dominio di fallback usato quando hostname -f non restituisce un FQDN completo.
# Esempio: se l'hostname è "raspberrypi" e fallback_domain = "home.local",
# il FQDN riportato sarà "raspberrypi.home.local".
# Se omesso, viene usato il solo hostname corto.
#fallback_domain = home.local

# Salva l'ultimo JSON raccolto su ./store/last.json dopo ogni ciclo.
# Utile per debug o per integrazioni che leggono da filesystem.
#save_json = false

# Tempo massimo, in secondi, per attendere i worker asincroni nelle modalità
# --test, --dry-run o Daemon.enabled=false. Default: 180.
#one_shot_wait_seconds = 180


# ---------------------------------------------------------------------------
[Modules]
# ---------------------------------------------------------------------------
#
# Formato: chiave = nome_file_modulo,NomeClasse
#
# Il daemon cerca il modulo in mods/<nome_file_modulo>.py e istanzia
# <NomeClasse>(config). I moduli vengono caricati dinamicamente con
# importlib — nessun restart necessario per aggiungerne di nuovi,
# basta aggiungere la riga qui e riavviare il servizio.
#
# I moduli con dipendenze opzionali (docker, keepalived) si disabilitano
# automaticamente se il tool non è installato — nessun errore a runtime.
#
# Moduli disponibili:
operative_system = gen_linux_os,GenericLinuxOS
device           = rpi_device,RPIDevice
docker           = docker_mon,DockerMon
keepalived       = keepalived_mon,KeepalivedMon

# Speedtest è disabilitato di default perché ogni esecuzione genera traffico
# significativo. Decommentare solo dopo aver configurato la sezione [Speedtest].
#speedtest        = speedtest_mon,SpeedtestMon

# Monitor di rete e DNS (catena AdGuard + Unbound): sonde ICMP/TCP/DNS e
# rilevamento dei blackout. Richiede dnspython. Disabilitato di default perché
# serve dichiarare le sonde: decommentare dopo aver configurato [DnsMonitor probes].
#dns_monitor      = dns_mon,DnsMon

# Per disabilitare un modulo: commentare la riga corrispondente.
# Per aggiungere un modulo custom: creare mods/mio_modulo.py con una classe
# che estende BaseModule e aggiungere la riga:
#   mio_modulo = mio_modulo,MioModulo


# ---------------------------------------------------------------------------
[MQTT]
# ---------------------------------------------------------------------------

# Hostname o indirizzo IP del broker MQTT.
# Variabile d'ambiente: MQTT_HOSTNAME (ha precedenza su questo valore)
# Default: localhost
#hostname = localhost

# Porta TCP del broker.
# Variabile d'ambiente: MQTT_PORT
# Default: 1883 (plain), 8883 (TLS)
#port = 1883

# Credenziali di autenticazione. Lasciare commentate queste due righe: questo
# file è facile da condividere per errore. Fonti consigliate, in ordine di
# precedenza:
#   1. credenziali systemd cifrate (scripts/install.sh le crea);
#   2. variabili d'ambiente MQTT_USERNAME, MQTT_PASSWORD
#      (ad esempio da /etc/platform-monitor/env);
#   3. questi valori, solo come ripiego.
# Se il broker non richiede autenticazione, omettere tutto.
#username = user
#password = secret

# Intervallo keepalive in secondi: tempo massimo tra ping al broker.
# Valori bassi aumentano il traffico ma rilevano disconnessioni più velocemente.
# Default: 60
#keepalive = 60

# QoS usato per values, availability, timestamp e LWT. Default: 1.
#qos = 1

# Timeout della prima connessione e della conferma delle pubblicazioni QoS.
#connect_timeout_seconds = 10
#publish_timeout_seconds = 10

# Backoff di riconnessione gestito automaticamente da Paho.
#reconnect_min_delay_seconds = 1
#reconnect_max_delay_seconds = 60

# ---------------------------------------------------------------------------
# TLS — lasciare tls = false per connessioni plain (default)
# ---------------------------------------------------------------------------

# Abilita TLS/SSL sulla connessione MQTT (porta tipica: 8883).
#tls = false

# Percorso del file CA per la verifica del certificato server.
# Se omesso con tls = true, viene usato il bundle CA di sistema
# (equivalente al comportamento di curl senza --cacert).
#tls_ca_cert = /etc/ssl/certs/ca-certificates.crt

# Certificato client e chiave privata per autenticazione TLS mutua (mTLS).
# Entrambi obbligatori se il broker richiede autenticazione client via certificato.
#tls_certfile = /etc/platform-monitor/client.crt
#tls_keyfile  = /etc/platform-monitor/client.key


# ---------------------------------------------------------------------------
[MQTT topic]
# ---------------------------------------------------------------------------
#
# Il topic completo per ogni dato è costruito come:
#   {base_topic}/{sensor_name}/{subtopic}
#
# Subtopic pubblicati:
#   /values       — JSON con tutte le metriche (retain=true)
#   /availability — "online" / "offline"        (retain=true)
#   /timestamp    — ISO 8601 dell'ultimo ciclo  (retain=false)

# Prefisso comune a tutti i topic di questo nodo.
# Default: home/nodes
#base_topic = home/nodes

# Nome univoco di questo nodo nel topic.
# Usare un nome che identifichi chiaramente la macchina.
# Default: rpi-reporter
#sensor_name = rpi-{hostname}


# ---------------------------------------------------------------------------
[Daemon]
# ---------------------------------------------------------------------------

# Esecuzione continua come daemon (true) o singola esecuzione e uscita (false).
# In modalità singola equivale a --test da riga di comando.
# Default: true
#enabled = true

# Intervallo tra un ciclo di raccolta e il successivo, in minuti.
# Minimo: 1 minuto (valori inferiori vengono ignorati e sostituiti con 1).
# Default: 1
#interval_in_minutes = 5


# ---------------------------------------------------------------------------
[Speedtest]
# ---------------------------------------------------------------------------

# Configurazione del modulo opzionale speedtest_mon.
# Per abilitarlo, decommentare anche questa riga in [Modules]:
#   speedtest = speedtest_mon,SpeedtestMon
#
# Il client richiesto è Speedtest CLI ufficiale Ookla (comando: speedtest),
# non il differente pacchetto Python "speedtest-cli".

# Intervallo tra due test reali. Il daemon può continuare a pubblicare ogni
# minuto: tra un test e l'altro il modulo restituisce l'ultimo risultato.
# Valore consigliato: 30-60 minuti. Minimo applicato: 15. Default: 60.
#interval_in_minutes = 60

# Tempo massimo concesso al comando speedtest. Range accettato: 10-600 secondi.
# Default: 120.
#timeout_seconds = 120

# Esegue un test dopo il ritardo iniziale. Default: false, così restart ripetuti
# non provocano nuovi test a ogni avvio.
#run_on_start = false

# Ritardo iniziale e jitter casuale applicato alla pianificazione. Il jitter
# evita che più nodi eseguano il test nello stesso istante.
#startup_delay_seconds = 60
#jitter_seconds = 300

# Backoff dopo errori consecutivi: 15, 30, 60... fino al massimo indicato.
#retry_interval_minutes = 15
#max_retry_interval_minutes = 240

# Accetta in modo non interattivo licenza e informativa GDPR. Necessario quando
# il client gira come servizio systemd senza terminale interattivo.
#accept_license = true
#accept_gdpr = true

# Se specificato, forza un server invece della selezione automatica.
# Ricavare gli ID con: speedtest --servers
#server_id = 12345

# Binding opzionale. Sono alternative/filtri passati direttamente al client.
#interface = eth0
#ip = 192.168.1.10
#host = speedtest.example.net

# Cache persistente dell'ultimo esito. Stringa vuota per disabilitarla.
# Se omesso usa PLATFORM_MONITOR_STORE_DIR/speedtest.json; con la unit systemd
# fornita il percorso è /var/lib/platform-monitor/speedtest.json, mentre in
# esecuzione manuale il fallback è ./store/speedtest.json.
#cache_file = /var/lib/platform-monitor/speedtest.json

# Lock inter-processo: impedisce esecuzioni concorrenti da daemon, --test o
# --dry-run sulla stessa macchina. Stringa vuota per disabilitarlo.
#lock_file = /var/lib/platform-monitor/speedtest.lock


# ---------------------------------------------------------------------------
[DnsMonitor]
# ---------------------------------------------------------------------------

# Configurazione del modulo opzionale dns_mon, che monitora la catena
#   client -> AdGuard -> Unbound -> (DoT) -> WAN
# con sonde ICMP, TCP e DNS e indica in quale livello si interrompe.
# Per abilitarlo, decommentare anche questa riga in [Modules]:
#   dns_monitor = dns_mon,DnsMon
# e dichiarare le sonde in [DnsMonitor probes]. Richiede dnspython.
#
# Il modulo ha un proprio thread di campionamento, indipendente da
# [Daemon] interval_in_minutes: a ogni ciclo il daemon pubblica l'ultimo stato
# aggregato. Le sonde usano solo indirizzi IP, mai nomi, per non dipendere dal
# DNS che stanno misurando.
#
# ICMP: viene usato un socket "ping" non privilegiato (richiede che
# net.ipv4.ping_group_range includa il gruppo del servizio; è il default di
# Debian/Proxmox) oppure un socket raw (CAP_NET_RAW, ad esempio se il servizio
# gira come root). Se nessuno dei due è disponibile le sonde icmp ripiegano su
# una connessione TCP alla porta 53 e il JSON le riporta come "tcp_fallback".

# --- Frequenze di campionamento --------------------------------------------

# Sonde di rete (icmp e tcp). Range 2-3600. Default: 10.
#network_interval_seconds = 10

# Sonde DNS (AdGuard, Unbound, resolver pubblico). Range 5-3600. Default: 30.
#dns_interval_seconds = 30

# Sonde "pesanti": query su un nome casuale, che non può essere in cache e
# attraversa tutta la catena fino ai server autoritativi. Range 1-1440. Default: 5.
#heavy_interval_minutes = 5

# --- Campionamento adattivo ------------------------------------------------
# Quando una sonda inizia a fallire le misure si infittiscono, per datare con
# precisione inizio e fine del guasto; a riposo il carico resta minimo.
# Il cache-miss non viene accelerato.

# Default: true
#adaptive_enabled = true

# Intervallo durante un guasto. Range 1-60. Default: 3.
#adaptive_interval_seconds = 3

# Successi consecutivi di ogni sonda per tornare al ritmo normale. Default: 5.
#adaptive_recovery_cycles = 5

# Durata massima del campionamento veloce. Un guasto permanente (ad esempio un
# peer che filtra l'ICMP) non lo mantiene attivo per sempre: scaduto il tempo,
# le sonde ancora in errore vengono ignorate finché non si riprendono, mentre
# un nuovo guasto lo riattiva. Range 1-1440. Default: 10.
#adaptive_max_minutes = 10

# --- Timeout e tentativi ---------------------------------------------------
#icmp_timeout_seconds = 1
#tcp_timeout_seconds = 2
#dns_timeout_seconds = 2

# Tentativi aggiuntivi immediati prima di considerare fallita una misura. Default: 1.
#retries = 1

# Sonde eseguite in parallelo. Evita che i timeout di un guasto allunghino il
# ciclo. Range 1-16. Default: 4.
#max_parallel_probes = 4

# --- Soglie ----------------------------------------------------------------

# Misure fallite consecutive dopo cui una sonda è considerata "giù". Un livello
# è guasto solo quando TUTTE le sue sonde sono giù; se ne cade una sola lo
# stato è "degraded". Default: 3.
#failures_before_down = 3

# Durata minima, in secondi, di un livello guasto per contarlo come blackout.
# Le interruzioni più brevi sono contate in short_outages_24h. Default: 60.
#blackout_threshold_seconds = 60

# Finestra mobile per success_pct e percentili (p50, p95). Range 1-180. Default: 15.
#window_minutes = 15

# --- Domini di prova -------------------------------------------------------

# Domini stabili interrogati a rotazione dalle sonde dns (di norma in cache).
#test_domains = example.com, wikipedia.org, cloudflare.com

# Zona per il cache-miss: si interroga <etichetta casuale>.<zona>. NXDOMAIN è una
# risposta valida: ciò che si misura è la capacità di risolvere. Vuoto per disattivare.
#cache_miss_zone = example.com

# Livelli delle sonde dns su cui eseguire il cache-miss. Default: unbound.
#cache_miss_layers = unbound

# --- Speedtest e persistenza -----------------------------------------------

# Lock di [Speedtest] lock_file. Lo speedtest satura la WAN: i blackout avvenuti
# durante un test, o nei due minuti precedenti, sono segnalati con
# during_speedtest. Il modulo legge /proc/locks e non prende mai il lock, quindi
# non interferisce con lo speedtest. Deve coincidere con [Speedtest] lock_file.
# Stringa vuota per disattivare. Se omesso: PLATFORM_MONITOR_STORE_DIR/speedtest.lock.
#speedtest_lock_file = /var/lib/platform-monitor/speedtest.lock

# Registro dei blackout conclusi, conservato tra i riavvii. Lo stato pubblicato
# è sempre derivato da qui: se MQTT non è raggiungibile durante un blackout, gli
# eventi vengono pubblicati al ciclo successivo. Stringa vuota per disattivarlo.
# Se omesso: PLATFORM_MONITOR_STORE_DIR/dns_monitor.json.
#state_file = /var/lib/platform-monitor/dns_monitor.json


# ---------------------------------------------------------------------------
[DnsMonitor probes]
# ---------------------------------------------------------------------------
#
# Formato:  nome = tipo,destinazione,livello
#
#   tipo          icmp  ip                  echo request IPv4
#                 tcp   ip:porta            connessione TCP
#                 dns   ip[:porta]          query A via UDP (porta 53 se omessa)
#                       IPv6 con parentesi: [2001:db8::1]:853
#   livello       gateway | wan | dot_upstream | unbound | adguard
#                 Dal più basso al più alto della catena: failed_layer riporta
#                 il livello più basso in cui tutte le sonde sono giù.
#
# Solo indirizzi IP: i nomi DNS non sono ammessi. Il nome della riga diventa la
# chiave nel JSON (lettere, cifre, _ e -). Per disabilitare una sonda basta
# commentare la riga. Esempio per una catena AdGuard (porta 53) davanti a
# Unbound (porta 5353) con DoT verso Cloudflare, da adattare alla propria rete:

#gateway        = icmp,192.168.1.1,gateway
#wan_cloudflare = icmp,1.1.1.1,wan
#wan_quad9      = icmp,9.9.9.9,wan
#wan_google     = icmp,8.8.8.8,wan
#dns_public     = dns,1.1.1.1:53,wan
#dot_upstream   = tcp,1.1.1.1:853,dot_upstream
#unbound        = dns,192.168.1.1:5353,unbound
#adguard        = dns,192.168.1.1:53,adguard


# ---------------------------------------------------------------------------
[Logger sessions]
# ---------------------------------------------------------------------------
#
# Configurazione del logging in formato standard Python logging.config.fileConfig.
# Modificare level= per cambiare la verbosità senza riavviare
# (richiede comunque reload del servizio).
#
# Per abilitare il logging su file aggiungere un FileHandler:
#   [handlers]
#   keys=consoleHandler,fileHandler
#
#   [handler_fileHandler]
#   class=FileHandler
#   formatter=simpleFormatter
#   args=('/var/log/platform-monitor.log', 'a')

    [loggers]
    keys=root,platformMonitor

    [handlers]
    keys=consoleHandler

    [formatters]
    keys=simpleFormatter

    [logger_root]
    level=WARNING
    handlers=consoleHandler

    [logger_platformMonitor]
    level=INFO
    handlers=consoleHandler
    qualname=platformMonitor
    propagate=0

    [handler_consoleHandler]
    class=StreamHandler
    formatter=simpleFormatter
    args=(sys.stdout,)

    [formatter_simpleFormatter]
    format=%(asctime)s - %(name)s - %(levelname)s - %(message)s
    datefmt=%Y-%m-%d %H:%M:%S
